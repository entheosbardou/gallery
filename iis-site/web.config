<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="WallpaperRoot" value="\\nas.thelinclan.com\data\wallpapers" />
    <add key="GalleryData" value="C:\downloads\gallery\iis-data" />
    <add key="WallhavenKeyFile" value="\\nas.thelinclan.com\data\wallpapers\wallhaven-api-key.txt" />
    <add key="DeleteDuplicateFiles" value="true" />
    <add key="DatabaseEnabled" value="true" />
    <add key="DatabaseConfig" value="C:\downloads\gallery\iis-data\mysql.json" />
    <add key="GalleryAuthEnabled" value="true" />
    <add key="GalleryAuthConfig" value="C:\downloads\gallery\iis-data\oidc.json" />
    <add key="GalleryPagedInventory" value="true" />
    <add key="GalleryLegacyDownloads" value="true" />
  </appSettings>
  <system.web>
    <compilation targetFramework="4.8" debug="false" />
    <httpRuntime targetFramework="4.8" executionTimeout="180" maxRequestLength="2048" />
    <customErrors mode="On" />
  </system.web>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <handlers>
      <add name="GalleryAuthentication" path="auth/*" verb="*" type="GalleryAuthHandler, WallpaperGallery" resourceType="Unspecified" preCondition="integratedMode,runtimeVersionv4.0" />
      <add name="WallpaperGalleryApi" path="api/*" verb="*" type="GalleryHandler, WallpaperGallery" resourceType="Unspecified" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
    <httpErrors existingResponse="PassThrough" />
    <modules runAllManagedModulesForAllRequests="true">
      <add name="GalleryAuth" type="GalleryAuthModule, WallpaperGallery" />
    </modules>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="2097152" />
      </requestFiltering>
    </security>
  </system.webServer>
  <runtime>
